package views

// ProductFormData conserva los campos cuando el servidor rechaza el formulario.
type ProductFormData struct {
	Nombre      string
	Descripcion string
	Precio      string
	Stock       string
	Categoria   string
}

templ ProductForm(data ProductFormData, message string) {
	<aside class="panel-formulario" aria-labelledby="titulo-formulario">
		<p class="sobrelinea">NUEVA FRAGANCIA</p>
		<h2 id="titulo-formulario">Agregar un producto</h2>
		<p class="ayuda-formulario">Completá los datos para sumar un perfume al catálogo.</p>
		<form id="formulario-producto" method="post" action="/productos">
			<label for="nombre_prod">Nombre del perfume</label>
			<input id="nombre_prod" name="nombre_prod" value={ data.Nombre } type="text" maxlength="255" placeholder="Ej.: Chanel No. 5" required/>
			<label for="descripcion_prod">Descripción</label>
			<textarea id="descripcion_prod" name="descripcion_prod" rows="3" maxlength="1000" placeholder="Contanos sobre esta fragancia">{ data.Descripcion }</textarea>
			<div class="campos-en-fila">
				<div>
					<label for="precio_prod">Precio</label>
					<input id="precio_prod" name="precio_prod" value={ data.Precio } type="number" min="0.01" step="0.01" placeholder="15000.00" required/>
				</div>
				<div>
					<label for="stock_prod">Stock</label>
					<input id="stock_prod" name="stock_prod" value={ data.Stock } type="number" min="0" step="1" placeholder="10" required/>
				</div>
			</div>
			<label for="categoria">Categoría</label>
			<input id="categoria" name="categoria" value={ data.Categoria } type="text" maxlength="100" placeholder="Ej.: Fragancias" required/>
			<button class="boton boton-principal" type="submit">Agregar al catálogo <span aria-hidden="true">→</span></button>
			if message != "" {
				<p id="mensaje-formulario" class="mensaje error" role="alert">{ message }</p>
			}
		</form>
	</aside>
}
